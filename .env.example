# Database Configuration
# For local development, use SQLite
DATABASE_URL="file:./dev.db"

# Admin authentication. Production fails closed if ADMIN_PASSWORD is missing.
ADMIN_PASSWORD=""
# Optional independent HMAC secret for signed sessions. When omitted, the
# admin password signs sessions for backwards-compatible deployments.
AUTH_SECRET=""

# For production with Turso (distributed SQLite):
# TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# API Keys
# Google Books works without a key (shared anonymous quota, prone to 429s).
# Set a key for a private 1,000 req/day quota. In production this is injected
# from Secret Manager (GOOGLE_BOOKS_API_KEY) via cloudbuild.yaml.
# GOOGLE_BOOKS_API_KEY="your-google-books-api-key"
# Override the access country sent to Google Books (defaults to US).
# GOOGLE_BOOKS_COUNTRY="US"

# Todoist Integration
# Get your API token from: https://todoist.com/app/settings/integrations/developer
TODOIST_API_TOKEN=""
# Your "Stuff to Read" project ID (get from Todoist URL or leave empty to select in UI)
TODOIST_PROJECT_ID=""

# Notion Integration
# Get your integration token from: https://www.notion.so/my-integrations
NOTION_API_TOKEN=""
# Your reading list database ID (get from database URL or leave empty to select in UI)
NOTION_DATABASE_ID=""
